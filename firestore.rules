rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /schedules/{userId} {
      // Team view is intentionally shared with signed-in members.
      allow read: if request.auth != null;

      // Every write is bound to the caller's immutable Firebase UID.
      allow create, update: if request.auth != null
        && userId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.semesterEndDate is string
        && (!('intensiveWork' in request.resource.data)
          || request.resource.data.intensiveWork is bool)
        && (!('intensiveStartDate' in request.resource.data)
          || request.resource.data.intensiveStartDate is string)
        && request.resource.data.workplaceType in ['onCampus', 'offCampus']
        && request.resource.data.keys().hasOnly([
          'ownerUid',
          'legacyId',
          'semesterEndDate',
          'intensiveWork',
          'intensiveStartDate',
          'workplaceType',
          'name',
          'defaults',
          'exceptions',
          'startDefaults',
          'startExceptions',
          'lunchDefaults',
          'lunchExceptions',
          'createdAt',
          'updatedAt'
        ]);
      allow delete: if request.auth != null && userId == request.auth.uid;
    }
  }
}
